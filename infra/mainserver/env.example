DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=anicast.online,www.anicast.online,10.78.0.2,localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://anicast.online
POSTGRES_DB=anicast
POSTGRES_USER=anicast
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Redis carries the Celery broker, so reaching it means executing code in the
# worker. The password must appear in every URL below as well.
REDIS_PASSWORD=replace-with-long-random-password
CACHE_URL=redis://:replace-with-long-random-password@redis:6379/2
CELERY_BROKER_URL=redis://:replace-with-long-random-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-long-random-password@redis:6379/1
TZ=UTC
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_NOTIFY_BOT_TOKEN=replace-with-notification-bot-token
TELEGRAM_NOTIFY_BOT_USERNAME=replace_with_notification_bot_username
TELEGRAM_NOTIFY_WEBHOOK_SECRET=replace-with-notification-webhook-secret
# api.telegram.org is unreachable from MainServer, so notifications go through
# the relay Caddy exposes inside the AmneziaWG tunnel. Leave unset on a host with
# working egress to call Telegram directly. See docs/OPERATIONS.md.
TELEGRAM_API_BASE_URL=http://10.78.0.1:8443
KODIK_API_TOKEN=replace-with-kodik-api-token
# Outbound mail for password reset and address verification. Unlike Telegram,
# SMTP egress from MainServer works (verified 2026-09-04 on 587 and 465 with
# STARTTLS), so no relay is involved — only credentials.
#
# Leaving EMAIL_HOST empty is a supported state: the affected endpoints answer
# 503 with a reason and nothing is queued. Registration and login keep working.
# The address in DEFAULT_FROM_EMAIL must be one the provider is authorised to
# send for, and anicast.online needs SPF/DKIM/DMARC records before mail from it
# will pass filters — see docs/OPERATIONS.md.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=AniCast <noreply@anicast.online>
# Lifetime of reset and verification links, in seconds (default 24 h).
ACCOUNT_LINK_TTL_SECONDS=86400
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
POSTERS_PUBLIC_BASE=https://anicast.online
LOG_LEVEL=INFO
BACKEND_IMAGE=anicast-backend:local
RELEASE_SHA=local-development
ANICAST_ENV_FILE=env.example

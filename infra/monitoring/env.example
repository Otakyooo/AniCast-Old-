# Monitoring stack secrets are materialized into infra/monitoring/secrets/
# files (gitignored) and mounted read-only into containers:
#   secrets/metrics-token     <- METRICS_BEARER_TOKEN from infra/mainserver/.env
#   secrets/telegram-token    <- OPS_TELEGRAM_BOT_TOKEN
#   secrets/telegram-chat-id  <- OPS_TELEGRAM_CHAT_ID

# Ops bot that receives Alertmanager and backup-failure notifications.
# Create via @BotFather. After creating, message the bot with /start and
# read the chat id: https://api.telegram.org/bot<TOKEN>/getUpdates
OPS_TELEGRAM_BOT_TOKEN=replace-with-ops-bot-token
OPS_TELEGRAM_CHAT_ID=replace-with-chat-id
